# Environment
ENV=dev
PROJECT_NAME=netcare-ml-platform

# Data
RAW_DATA_PATH=data/raw/hospital_readmissions.csv
PROCESSED_DATA_PATH=data/processed
FEATURE_STORE_PATH=data/features
ARTIFACTS_PATH=artifacts

# Model
MODEL_NAME=readmission_xgboost
EXPERIMENT_NAME=netcare-readmission
REGISTERED_MODEL_NAME=netcareaidatabricks.default.readmission_model

# MLflow / Unity Catalog
MLFLOW_TRACKING_URI=databricks
MLFLOW_REGISTRY_URI=databricks-uc

# Databricks
# Local development uses the Databricks CLI OAuth profile (DEFAULT).
# Do not put a personal access token in this file.
DATABRICKS_HOST=https://8259552034754034.4.gcp.databricks.com
DATABRICKS_CONFIG_PROFILE=DEFAULT

# API
API_HOST=0.0.0.0
API_PORT=8000
API_KEY=

# Monitoring
DRIFT_THRESHOLD=0.15
PERFORMANCE_ALERT_THRESHOLD=0.05
